# Optional Streamlit Cloud secrets. The deployed app defaults to replay mode
# (no key needed). Add a DeepInfra key here only if you want the deployed
# instance to make live LLM calls.
#
# DEEPINFRA_API_KEY = "sk-..."
# DEEPINFRA_MODEL_THEORIST = "moonshotai/Kimi-K2.6"
# DEEPINFRA_MODEL_SKEPTIC = "zai-org/GLM-5.1"
# DEEPINFRA_MODEL_ADJUDICATOR = "deepseek-ai/DeepSeek-V4-Pro"
