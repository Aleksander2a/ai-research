{"finding_id": "f_b38c6394a5fe", "hypothesis": "In regime 3\u2014characterized by extreme dominance of the US dollar (DX-Y.NYB) and elevated volatility (^VIX)\u2014TLT, despite its low eigenvector centrality, exhibits heightened sensitivity to dollar strength due to its role as a safe-haven asset. A chronos2_multivariate model for TLT that includes only DX-Y.NYB as a covariate will outperform both the full multivariate model and the naive baseline specifically in this regime, because extraneous macro variables dilute the strong inverse relationship between the dollar and long-duration Treasuries during flight-to-safety episodes.", "method": "tlt_regime3_dxy_only", "filters": {"asset": null, "regime_id": null}, "original_p": 0.014195677858098055, "original_skill": 0.1009180134496851, "fdr_alpha": 0.1, "fdr_q": 0.021293516787147082, "survives_fdr": true, "rw_q": null, "survives_rw": null, "cpcv": {"n_paths": 0, "skill_mean": NaN, "skill_std": NaN}, "deflated_sharpe": null, "survives_dsr": null, "adversarial": {"full_test": {"promotable": false, "reason": "empty"}, "placebo": {"promotable": false, "reason": "empty"}, "block_holdout": {"promotable": false, "reason": "no_forecast_origin"}, "survives_adversarial": false}, "survives_full_test": false, "survives_placebo": null, "survives_block_holdout": false, "survives_all": false, "survives_all_strict": false, "bayesian": {"posterior_mean": 0.18239092911273136, "posterior_sd": 0.025414542733097137, "prob_positive": 0.9999999999996427, "bayes_factor": 13.261685617979197, "n": 115}, "survives_bayes": true, "evaluated_at": "2026-04-27T14:09:49.676898+00:00"}
