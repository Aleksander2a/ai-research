# AutoSignal-X — environment configuration template.
# Copy to .env (gitignored) and fill in values you want to override.

# ---- LLM provider (DeepInfra, OpenAI-compatible) ----
# Used by the agent layer. Without a key, the agent runs in deterministic
# replay mode against replay/agent_steps.jsonl (a recorded session is
# committed to the repo). The cockpit panels work either way.
DEEPINFRA_API_KEY=

# Per-role models for the multi-agent debate (Theorist / Skeptic /
# Adjudicator). Leave empty to use defaults: Kimi-K2.6 / GLM-5.1 /
# DeepSeek-V4-Pro respectively.
DEEPINFRA_MODEL_THEORIST=
DEEPINFRA_MODEL_SKEPTIC=
DEEPINFRA_MODEL_ADJUDICATOR=

# Single-LLM-mode roles (used when --mode single instead of --mode debate).
# Default to the same models as the debate roles via the env-var hierarchy
# in agent/llm.py:_model_for_role.
DEEPINFRA_MODEL_PROPOSER=
DEEPINFRA_MODEL_CRITIC=
DEEPINFRA_MODEL_CHAT=

# Override the DeepInfra base URL (rarely needed).
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Force replay mode even if a key is present (useful for cost control / CI).
AUTOSIGNALX_REPLAY=false

# ---- Per-model price overrides ----
# Defaults (USD per 1M tokens) live in agent/telemetry.py:DEFAULT_PRICES.
# To override, set the env var <PREFIX>_<MODEL_ID_UPPERCASED_WITH_UNDERSCORES>_<IN|OUT>.
# Example for moonshotai/Kimi-K2.6:
# DEEPINFRA_PRICE_MOONSHOTAI_KIMI_K2_6_IN=0.55
# DEEPINFRA_PRICE_MOONSHOTAI_KIMI_K2_6_OUT=2.20

# ---- Scheduled-session knobs (read by scripts/run_session.{sh,ps1}) ----
# Number of agent rounds per scheduled session.
AUTOSIGNALX_ROUNDS=5
# Agent mode: single (one LLM does propose/critique/decide) or
# debate (Theorist / Skeptic / Adjudicator with three different models).
AUTOSIGNALX_MODE=debate

# ---- Windows-specific ----
# If uv reports a cross-drive cache error during install, point the cache
# at a directory on the same drive as the repo:
# UV_CACHE_DIR=./.uv-cache
