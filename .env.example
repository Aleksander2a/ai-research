# AutoSignal-X — environment configuration template.
# Copy to .env (gitignored) and fill in values you want to override.

# DeepInfra (OpenAI-compatible) — used by the agentic layer (Iter 7+).
# Leave unset to use deterministic replay mode; the agent panel will play back
# pre-recorded traces from replay/ instead of making live calls.
DEEPINFRA_API_KEY=

# Model selection. Leave empty to resolve defaults at runtime against
# DeepInfra's live model catalog.
DEEPINFRA_MODEL_PROPOSER=
DEEPINFRA_MODEL_CRITIC=
DEEPINFRA_MODEL_CHAT=

# Override the DeepInfra base URL (rarely needed).
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Force replay mode even if a key is present (useful for cost control / CI).
AUTOSIGNALX_REPLAY=false

# Windows: if uv reports a cross-drive cache error during install, point the
# cache at a directory on the same drive as the repo.
# UV_CACHE_DIR=./.uv-cache
